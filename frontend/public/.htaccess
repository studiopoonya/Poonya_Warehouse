# Untuk web server LiteSpeed / Apache (dipakai VPS aaPanel). Ikut tersalin ke dist/ saat build.
# Semua alamat yang bukan file (mis. /events/12, /inventory) diarahkan ke index.html
# supaya React Router yang menangani — refresh di halaman mana pun tidak 404.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Paksa HTTPS (tombol "Force HTTPS" aaPanel hanya berlaku untuk Nginx, bukan LiteSpeed).
  # .well-known dikecualikan supaya perpanjangan SSL Let's Encrypt tetap jalan.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# index.html selalu dicek ulang supaya versi baru langsung terpakai setelah update;
# file di assets/ namanya berubah tiap build, jadi aman di-cache lama.
<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
